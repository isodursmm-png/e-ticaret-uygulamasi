# Bu dosyayı  .env  adıyla kopyalayın.  .env git'e EKLENMEZ.
# Yalnızca içe aktarma betiği (scripts/import.js) kullanır — tarayıcıya inmez.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co

# Supabase > Project Settings > API > Project API keys > service_role  (GİZLİ! sadece sunucu/CLI)
SUPABASE_SERVICE_ROLE=eyJhbGciOi...SERVICE_ROLE_KEY...

# xlsx kaynak klasörü (varsayılan: Masaüstü/ETICARET/Eticaret)
XLSX_DIR=C:/Users/İshak DURMUŞ/Desktop/ETICARET/Eticaret
