# Bu dosyayı  .env  adıyla kopyalayın.  .env git'e EKLENMEZ.
# Yalnızca içe aktarma betiği (scripts/import.js) kullanır — tarayıcıya inmez.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co

# Supabase > Project Settings > API > Project API keys > service_role  (GİZLİ! sadece sunucu/CLI)
SUPABASE_SERVICE_ROLE=eyJhbGciOi...SERVICE_ROLE_KEY...

# xlsx kaynak klasörü (varsayılan: Masaüstü/ETICARET/Eticaret)
XLSX_DIR=C:/Users/İshak DURMUŞ/Desktop/ETICARET/Eticaret

# ============================================================================
#  CANLI KAYNAKLAR  —  scripts/topla.js  (npm run topla)
#  Bunlar hem yerel .env'e, hem GitHub Actions Secrets/Variables'a,
#  gerekirse Vercel Environment Variables'a girer.
# ============================================================================

# kaç günlük geçmiş çekilsin
FETCH_DAYS=30

# Mağaza kodlarını dostane ada çevir (pano "Mağaza" alanı). "kod=Ad" çiftleri, ; ile.
# Trendyol GO storeId + Yemeksepeti vendor (market/restoran) kodları. Örn:
# STORE_NAMES=33800=Liman; woyx=Liman; ni1e=Erciyes; 33841=Erciyes
# normStore: ham değer bir kodu kelime olarak içeriyorsa o adı verir ("TGO 33800" → Liman).
STORE_NAMES=

# Ham satış arşivi (Supabase public.raw_orders) — her koşuda yeni satırlar eklenir.
# Kapatmak için: RAW_ORDERS=0   (şema: supabase/schema.sql çalıştırılmış olmalı)
RAW_ORDERS=1

# FİNAL segmenti "Enf. %" — aylık TÜİK TÜFE. TCMB EVDS API anahtarı (ücretsiz):
# https://evds2.tcmb.gov.tr → üye ol → Profil → "API Anahtarı".
# Boş bırakılırsa scripts/lib/tufe.js içindeki gömülü tablo kullanılır (2025-09'a kadar).
EVDS_API_KEY=

# ---- Ticimax (SOAP: <site>/Servis/SiparisServis.svc → SelectSiparis) ----
TICIMAX_API_URL=https://www.tahtakalespot.com   # site kökü yeterli; .svc yolu türetilir
TICIMAX_CODE=                                    # entegrasyon yetki kodu = <UyeKodu>
# TICIMAX_SERVIS_URL=https://www.tahtakalespot.com/Servis/SiparisServis.svc  # gerekirse tam .svc
# TICIMAX_TIMEOUT_MS=240000                      # yoğun bir ay tek istekte büyük yanıt döndürür
# NOT: servisin BaslangicIndex sayfalaması bozuk; adaptör AY AY pencere açıp
#      her ayı tek istekte çeker. Tüm geçmiş yavaştır (~60 dk).
# TICIMAX_FETCH_DAYS=                            # yalnız Ticimax için gün sınırı (0/boş=tüm geçmiş).
#                                                 Bir kez tüm geçmişi çekip sonra 45-60 gün'e düşür.

# ---- Trendyol (Satıcı Paneli > Hesap Bilgilerim > Entegrasyon Bilgileri) ----
TRENDYOL_SELLER_ID=                      # "Satıcı ID (Cari ID)"
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# Marketplace: https://apigw.trendyol.com   | Trendyol GO: panelin verdiği taban adres
TRENDYOL_API_BASE=https://apigw.trendyol.com

# ---- Yemeksepeti = Delivery Hero "Partner API" (ÖNERİLEN, tarayıcısız) ----
# https://yemeksepeti.partner.deliveryhero.io  · OAuth2 client_credentials
YEMEKSEPETI_API_BASE=https://yemeksepeti.partner.deliveryhero.io
YEMEKSEPETI_CLIENT_ID=
YEMEKSEPETI_CLIENT_SECRET=
YEMEKSEPETI_CHAIN_ID=          # DH platform "chain" kimliği
# Mağaza (vendor) kimlikleri. Tek şube: YEMEKSEPETI_VENDOR_ID=xxxx
# Çok şube: virgülle tek satır  → YEMEKSEPETI_VENDOR_ID=ni1e,us58,woyx
#           ya da numaralı       → YEMEKSEPETI_VENDOR_ID1=ni1e  (…2, …3, …N)
YEMEKSEPETI_VENDOR_ID=
# NOT: getOrders ucu en fazla son 60 günü verir (gün sınırından bağımsız).
#
# ---- Playwright yolu (yalnızca API yoksa; A doluysa atlanır) ----
YEMEKSEPETI_USER=
YEMEKSEPETI_PASS=
# YS_LOGIN_URL=https://partner-app.yemeksepeti.com/
# YS_REPORT_URL=
# YS_SEL_EMAIL=
# YS_SEL_PASS=
# YS_SEL_SUBMIT=
# YS_SEL_LOGGEDIN=
# YS_SEL_EXPORT=

# ---- Trendyol GO / TGO Market (partner.tgomarket.com) ----
# A) API yolu (ÖNERİLEN — tarayıcısız). partner.tgomarket.com > Entegrasyon Bilgileri
TGO_SELLER_ID=                           # Satıcı / Supplier ID
TGO_API_KEY=
TGO_API_SECRET=
TGO_API_BASE=https://api.tgoapis.com
# TGO_TOKEN=                             # ops. hazır base64(key:secret)
# canlı test ile doğrulanan grocery uç noktası:
TGO_ORDER_PATH=https://api.tgoapis.com/integrator/order/grocery/suppliers/{supplierId}/packages
#
# B) Playwright yolu (yalnızca API yoksa; A doluysa bu atlanır)
TGO_USER=
TGO_PASS=
# TGO_LOGIN_URL=https://partner.tgomarket.com/
# TGO_ORDERS_URL=
# TGO_COMMISSION_URL=
# TGO_SEL_EMAIL=
# TGO_SEL_PASS=
# TGO_SEL_SUBMIT=
# TGO_SEL_LOGGEDIN=
# TGO_SEL_EXPORT=

# ============================================================================
#  Sadece Vercel (api/refresh.js) — panodaki "⟳ Yenile" düğmesi
# ============================================================================
# SUPABASE_ANON_KEY=                     # oturum doğrulama (zaten deploy env'inde)
# GH_DISPATCH_REPO=isodursmm-png/e-ticaret-uygulamasi
# GH_DISPATCH_TOKEN=                     # fine-grained PAT — Contents: Read and write
# CRON_SECRET=                           # opsiyonel, Vercel Cron GET koruması
