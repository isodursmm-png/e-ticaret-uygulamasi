<script type="text/javascript">

// ─── Sabit üst bloğun yüksekliği kadar içeriğe boşluk bırak ──────────────────
function fitHeader() {
    var ft = document.getElementById('fixedTop');
    var mc = document.getElementById('mainContent');
    if (ft && mc) { mc.style.paddingTop = (ft.offsetHeight + 6) + 'px'; }
}
// ─── Türkiye saati (UTC+3, DST yok) ───────────────────────────────────────────
function turkeyNow() {
    var d = new Date();
    var utcMs = d.getTime() + (d.getTimezoneOffset() * 60000);
    return new Date(utcMs + 3 * 3600000);
}
function setTodayBadge() {
    var AYLAR = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
    var GUNLER = ['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
    var d = turkeyNow();
    var el = document.getElementById('todayBadge');
    if (el) { el.textContent = GUNLER[d.getDay()] + ', ' + d.getDate() + ' ' + AYLAR[d.getMonth()] + ' ' + d.getFullYear(); }
}
function setAnalogClock() {
    var d = turkeyNow();
    var h = d.getHours() % 12, m = d.getMinutes(), s = d.getSeconds(), ms = d.getMilliseconds();
    var secFrac = s + ms / 1000;
    var minFrac = m + secFrac / 60;
    var hourDeg = (h * 30) + (minFrac * 0.5);
    var minDeg = minFrac * 6;
    var secDeg = secFrac * 6;
    var hourEl = document.getElementById('clockHour');
    var minEl = document.getElementById('clockMin');
    var secEl = document.getElementById('clockSec');
    if (hourEl) { hourEl.setAttribute('transform', 'rotate(' + hourDeg + ' 50 50)'); }
    if (minEl) { minEl.setAttribute('transform', 'rotate(' + minDeg + ' 50 50)'); }
    if (secEl) { secEl.setAttribute('transform', 'rotate(' + secDeg + ' 50 50)'); }
}
setTodayBadge();
setAnalogClock();
setInterval(setTodayBadge, 1000);
setInterval(setAnalogClock, 200);
window.onload = fitHeader;
window.onresize = fitHeader;
fitHeader();

// ─── Döviz kurları (TCMB günlük kur XML'i) ───────────────────────────────────
function fmtRate(v) {
    var n = parseFloat(v);
    if (isNaN(n)) return '—';
    return n.toFixed(2).replace('.', ',');
}

function loadFX(silent) {
    var body = document.getElementById('fxBody');
    var dateEl = document.getElementById('fxDate');
    var btn = document.getElementById('fxRefresh');
    if (!silent) {
        body.innerHTML = '<div class="fx-loading">TCMB kurları yükleniyor...</div>';
        if (btn) { btn.className = 'fx-refresh spinning'; }
        fitHeader();
    }
    try {
        var xhr = new ActiveXObject('Msxml2.XMLHTTP.6.0');
        xhr.open('GET', 'https://www.tcmb.gov.tr/kurlar/today.xml', true);
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            try {
                if (xhr.status !== 200) throw new Error('HTTP ' + xhr.status);
                var doc = new ActiveXObject('Msxml2.DOMDocument.6.0');
                doc.async = false;
                doc.loadXML(xhr.responseText);
                var root = doc.selectSingleNode('Tarih_Date');
                if (root && dateEl) {
                    var nowT = new Date();
                    var hh = ('0' + nowT.getHours()).slice(-2);
                    var mm = ('0' + nowT.getMinutes()).slice(-2);
                    dateEl.innerHTML = '· ' + root.getAttribute('Tarih') + ' · Güncellendi: ' + hh + ':' + mm;
                }

                function curBlock(code, label) {
                    var node = doc.selectSingleNode("Tarih_Date/Currency[@CurrencyCode='" + code + "']");
                    if (!node) return '';
                    var fb = node.selectSingleNode('ForexBuying');
                    var fs = node.selectSingleNode('ForexSelling');
                    var bb = node.selectSingleNode('BanknoteBuying');
                    var bs = node.selectSingleNode('BanknoteSelling');
                    var fbv = fb ? fmtRate(fb.text) : '—';
                    var fsv = fs ? fmtRate(fs.text) : '—';
                    var bbv = bb ? fmtRate(bb.text) : '—';
                    var bsv = bs ? fmtRate(bs.text) : '—';
                    return '<div class="fx-cur-block"><div class="fx-cur-code">' + label + '</div>' +
                        '<div class="fx-cur-rates">' +
                        '<span class="fx-lbl">Döviz</span><b>' + fbv + '</b> / <b>' + fsv + '</b><br>' +
                        '<span class="fx-lbl">Efektif</span><b>' + bbv + '</b> / <b>' + bsv + '</b>' +
                        '</div></div>';
                }

                var html = curBlock('USD', '$') + curBlock('EUR', '€');
                if (!html) throw new Error('Kur verisi bulunamadi');
                body.innerHTML = html;
                fitHeader();
            } catch (e2) {
                if (!silent) {
                    body.innerHTML = '<div class="fx-error">Kurlar alinamadi (' + e2.message + ')</div>';
                    fitHeader();
                }
            }
            if (btn && !silent) { btn.className = 'fx-refresh'; }
        };
        xhr.send();
    } catch (e) {
        if (!silent) {
            body.innerHTML = '<div class="fx-error">Kurlar alinamadi (internet/ActiveX)</div>';
            if (btn) { btn.className = 'fx-refresh'; }
        }
    }
}
loadFX();
setInterval(function () { loadFX(true); }, 15 * 60 * 1000); // Kurları 15 dakikada bir, kullanıcıya belli etmeden (sessiz) otomatik yenile

// ─── Dosya açma fonksiyonu (WScript.Shell ile) ───────────────────────────────
var _baseDir = null;

function getBaseDir() {
    if (_baseDir) return _baseDir;
    try {
        var href = window.location.href;
        href = href.replace(/^file:\/\/\//i, '');
        try { href = decodeURIComponent(href); } catch(ex) {}
        href = href.replace(/\//g, '\\');
        var p = href.lastIndexOf('\\');
        if (p >= 0) href = href.substring(0, p + 1); // = ...Desktop\
        _baseDir = href + 'CLAUDE\\';
    } catch(e) {
        _baseDir = '';
    }
    return _baseDir;
}

function openFile(fn) {
    try {
        var sh = new ActiveXObject('WScript.Shell');
        var dir = getBaseDir();
        var fullPath = dir + fn;
        sh.Run('"' + fullPath + '"', 1, false);
    } catch(e) {
        var dir2 = getBaseDir();
        alert('Dosya açılamadı.\n\nKlasör: ' + dir2 + '\nDosya: ' + fn + '\n\nLütfen dosyanın bu klasörde bulunduğunu kontrol edin.\n\nHata: ' + e.message);
    }
}

// Yerel sunucu tabanlı (Node.js köprü) raporlar: port kapalıysa ilgili gizli VBS'i başlatıp
// sunucunun ayağa kalkmasını bekler. Startup'ta zaten daima çalışır durumda tutulan sunucular için
// bu, sadece oturum yeniden başlamış/sunucu bir şekilde kapanmışsa devreye giren bir güvence katmanıdır.
function ensureLocalServer(port, vbsName) {
    var calisiyor = false;
    try {
        var xhr = new ActiveXObject('Msxml2.XMLHTTP.6.0');
        xhr.open('GET', 'http://localhost:' + port + '/api/durum', false);
        xhr.send();
        calisiyor = (xhr.status === 200);
    } catch (e) { calisiyor = false; }

    if (!calisiyor) {
        try {
            var sh = new ActiveXObject('WScript.Shell');
            sh.Run('wscript.exe "' + getBaseDir() + vbsName + '"', 0, false);
            sh.Run('cmd /c timeout /t 2 /nobreak >nul', 0, true);
        } catch (e2) { /* sunucu başlatılamadıysa rapor yine de açılır, sayfa kendi hata mesajını gösterir */ }
    }
}

