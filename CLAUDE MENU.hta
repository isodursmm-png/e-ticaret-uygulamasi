<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>CLAUDE - Panosu</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Tahoma',Arial,sans-serif;background:#0a0e1a;color:#e2e8f0;font-size:14px;}

.fixed-top{position:fixed;top:0;left:0;right:0;z-index:100;background:#0a0e1a;box-shadow:0 8px 22px rgba(0,0,0,.45);}

.header{background:linear-gradient(120deg,#1a1040,#152451,#0d2b3e);border-bottom:2px solid #3b4a7a;padding:22px 32px;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:justify;justify-content:space-between;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16px;}
.header-left{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:16px;}
.logo{width:58px;height:58px;border-radius:14px;-ms-flex-negative:0;flex-shrink:0;overflow:hidden;background:linear-gradient(135deg,#7c3aed,#2563eb);display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:center;justify-content:center;box-shadow:0 0 0 3px rgba(124,58,237,.3);}
.logo img{width:100%;height:100%;object-fit:cover;}
.h-title{font-size:27px;font-weight:800;letter-spacing:.3px;font-family:'Segoe UI',Tahoma,Arial,sans-serif;}
.h-title .h-t1{color:#ffffff;}
.h-title .h-t2{color:#60a5fa;font-weight:400;margin:0 6px;}
.h-title .h-t3{color:#93c5fd;}
.h-sub{font-size:13px;color:#a7b4d4;margin-top:5px;font-weight:600;}
.info-chips{display:-ms-flexbox;display:flex;gap:14px;-ms-flex-wrap:wrap;flex-wrap:wrap;}
.chip{background:#1c2542;border:1px solid #3b4a7a;border-radius:10px;padding:8px 16px;font-size:13px;color:#d3dcf2;line-height:1.6;}
.chip strong{color:#ffffff;display:block;font-size:13px;}
.badge{padding:8px 18px;border-radius:20px;font-size:13px;font-weight:800;color:#34d399;border:1px solid #10b98166;background:#10b9811f;}

.clock-badge-wrap{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:14px;}
.analog-clock{width:78px;height:78px;-ms-flex-negative:0;flex-shrink:0;}
.clock-tz{font-size:9px;color:#93a3c4;text-align:center;text-transform:uppercase;letter-spacing:.4px;font-weight:800;margin-top:3px;}

.fx-chip{background:linear-gradient(135deg,#0f2e20,#0a1f16);border:1px solid #10b98166;border-radius:10px;padding:7px 16px;box-shadow:0 0 0 1px #10b98122,0 3px 12px rgba(16,185,129,.18);}
.fx-title-row{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:justify;justify-content:space-between;gap:10px;margin-bottom:4px;}
.fx-title{font-size:9.5px;font-weight:800;color:#6ee7b7;text-transform:uppercase;letter-spacing:.6px;}
.fx-date{color:#3f8f68;font-weight:600;text-transform:none;margin-left:4px;}
.fx-refresh{font-size:9.5px;font-weight:800;color:#34d399;text-decoration:none;border:1px solid #10b98155;border-radius:5px;padding:2px 7px;-webkit-user-select:none;-ms-user-select:none;user-select:none;}
.fx-refresh:hover{background:#10b9811f;color:#6ee7b7;}
.fx-refresh.spinning{opacity:.6;}
.fx-body{display:-ms-flexbox;display:flex;gap:16px;}
.fx-loading{font-size:11px;color:#7fd9ae;}
.fx-error{font-size:11px;color:#fca5a5;}
.fx-cur-block{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:8px;}
.fx-cur-code{font-size:14px;font-weight:800;color:#ffffff;width:30px;-ms-flex-negative:0;flex-shrink:0;}
.fx-cur-rates{font-size:10.5px;line-height:1.5;color:#d3f2e3;}
.fx-cur-rates b{color:#34d399;font-weight:800;}
.fx-lbl{color:#5fae86;font-weight:700;margin-right:3px;}

.top-fixed{max-width:1800px;margin:0 auto;padding:16px 32px 14px 32px;}
.main{padding:0 32px 24px;max-width:1800px;margin:0 auto;}

.kpi-row{display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:7px;margin-bottom:11px;}
.kpi{border-radius:8px;padding:5px 9px;position:relative;overflow:hidden;width:calc(20% - 6px);-ms-flex:0 0 calc(20% - 6px);flex:0 0 calc(20% - 6px);border:1px solid;box-shadow:0 2px 6px rgba(0,0,0,.24);display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:8px;}
.kpi.c1{background:linear-gradient(160deg,#15274d,#0e1830);border-color:#3b82f680;}
.kpi.c2{background:linear-gradient(160deg,#2c1d55,#180f2e);border-color:#8b5cf680;}
.kpi.c3{background:linear-gradient(160deg,#0f3a2c,#0b201c);border-color:#10b98180;}
.kpi.c4{background:linear-gradient(160deg,#40300e,#241a08);border-color:#f59e0b80;}
.kpi.c5{background:linear-gradient(160deg,#421534,#22091c);border-color:#ec489980;}
.kpi-val{font-size:15px;font-weight:800;color:#ffffff;line-height:1;-ms-flex-negative:0;flex-shrink:0;}
.kpi-txt{-ms-flex:1;flex:1;min-width:0;text-align:center;}
.kpi-lbl{font-size:8.5px;color:#b3bfdc;text-transform:uppercase;letter-spacing:.4px;font-weight:800;white-space:nowrap;}
.kpi-sub{font-size:8.5px;color:#7885a8;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

.search-wrap{margin-bottom:16px;}
#searchInput{width:100%;padding:8px 14px;background:#161d33;border:1px solid #3b4a7a;border-radius:8px;color:#f8fafc;font-size:12.5px;outline:none;}
#searchInput:focus{border-color:#60a5fa;box-shadow:0 0 0 3px rgba(96,165,250,.22);}
#resultCount{font-size:11px;color:#60a5fa;margin-top:5px;height:14px;font-weight:700;}

.hero-card{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:14px;margin:10px 0 0;padding:9px 20px;border-radius:10px;text-decoration:none;cursor:pointer;white-space:nowrap;overflow:hidden;background:linear-gradient(100deg,#4a3308,#5c3d0a 45%,#3a2806);border:1.5px solid #f59e0b;box-shadow:0 0 0 1px #f59e0b33,0 4px 16px rgba(245,158,11,.2);-webkit-transition:box-shadow .15s,-webkit-transform .15s;transition:box-shadow .15s,transform .15s;}
.hero-card:hover{box-shadow:0 0 0 1px #f59e0b55,0 6px 20px rgba(245,158,11,.32);-webkit-transform:translateY(-1px);transform:translateY(-1px);}
.hero-icon{font-size:18px;-ms-flex-negative:0;flex-shrink:0;width:34px;height:34px;border-radius:8px;background:#f59e0b26;border:1px solid #f59e0b55;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:center;justify-content:center;}
.hero-text{-ms-flex:1 1 auto;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hero-tag{font-size:10.5px;font-weight:800;color:#fcd34d;text-transform:uppercase;letter-spacing:.5px;margin-right:12px;padding:3px 9px;border:1px solid #f59e0b55;border-radius:5px;}
.hero-title{font-size:14.5px;font-weight:800;color:#fff8ec;margin-right:8px;}
.hero-file{font-size:11.5px;color:#e8c98a;font-weight:600;}
.hero-arrow{font-size:18px;color:#fcd34d;-ms-flex-negative:0;flex-shrink:0;font-weight:800;}
.hero-card.ik{background:linear-gradient(100deg,#2e1065,#4c1d95 45%,#1e0a47);border:1.5px solid #8b5cf6;box-shadow:0 0 0 1px #8b5cf633,0 4px 16px rgba(139,92,246,.2);}
.hero-card.ik:hover{box-shadow:0 0 0 1px #8b5cf655,0 6px 20px rgba(139,92,246,.32);}
.hero-card.ik .hero-icon{background:#8b5cf626;border:1px solid #8b5cf655;}
.hero-card.ik .hero-tag{color:#c4b5fd;border:1px solid #8b5cf655;}
.hero-card.ik .hero-title{color:#f5f3ff;}
.hero-card.ik .hero-file{color:#ddd6fe;}
.hero-card.ik .hero-arrow{color:#c4b5fd;}
.hero-card.hero-dual{cursor:default;}
.hero-dual-actions{display:flex;gap:8px;margin-left:auto;flex-shrink:0;}
.hero-mini-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border:1px solid #8b5cf655;border-radius:8px;background:#8b5cf61f;color:#f5f3ff;font-size:12.5px;font-weight:700;text-decoration:none;cursor:pointer;white-space:nowrap;}
.hero-mini-btn:hover{background:#8b5cf63a;}
.hero-mini-btn.alt{border:1px solid #fbbf2466;background:#fbbf241f;color:#fde68a;}
.hero-mini-btn.alt:hover{background:#fbbf243a;}
.hero-card.hero-dual{padding:5px 18px;margin-top:6px;}
.hero-card.hero-dual .hero-icon{width:24px;height:24px;font-size:13px;border-radius:6px;}
.hero-card.hero-dual .hero-title{font-size:13px;}
.hero-card.hero-dual .hero-file{font-size:10.5px;}
.hero-card.hero-dual .hero-tag{padding:2px 7px;margin-right:8px;}
.hero-card.hero-dual .hero-mini-btn{padding:4px 12px;font-size:11.5px;}
.hero-dual-logo{height:26px;width:48px;object-fit:contain;margin-right:14px;flex-shrink:0;border-radius:4px;background:#fff8ec;padding:2px 6px;}

.hr-module{margin:14px 0 0;border-radius:12px;overflow:hidden;background:linear-gradient(160deg,#161233,#0f1830);border:1.5px solid #6d4aff55;box-shadow:0 0 0 1px #6d4aff22,0 6px 20px rgba(0,0,0,.35);}
.hr-module-head{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;padding:14px 22px;background:linear-gradient(100deg,#2e1065,#1e2260 60%,#14204a);cursor:pointer;-webkit-user-select:none;-ms-user-select:none;user-select:none;}
.hr-module.open .hr-module-head{border-bottom:1.5px solid #6d4aff55;}
.hr-module-icon{font-size:19px;width:38px;height:38px;border-radius:10px;background:#8b5cf640;border:1px solid #8b5cf670;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:center;justify-content:center;-ms-flex-negative:0;flex-shrink:0;margin-right:14px;}
.hr-module-heading{-ms-flex:1;flex:1;min-width:0;}
.hr-module-title{display:block;font-size:15.5px;font-weight:800;color:#ffffff;letter-spacing:.6px;text-transform:uppercase;line-height:1.3;}
.hr-module-sub{display:block;font-size:11.5px;color:#c9bdf7;font-weight:600;letter-spacing:.15px;margin-top:3px;}
.hr-module-count{-ms-flex-negative:0;flex-shrink:0;font-size:11.5px;color:#a78bfa;font-weight:700;background:#8b5cf61f;border:1px solid #8b5cf655;border-radius:20px;padding:4px 13px;margin-left:14px;}
.hr-module-chevron{font-size:12px;color:#c4b5fd;font-weight:800;-ms-flex-negative:0;flex-shrink:0;width:18px;text-align:center;margin-left:12px;-webkit-transition:-webkit-transform .15s;transition:transform .15s;}
.hr-module.open .hr-module-chevron{-webkit-transform:rotate(180deg);transform:rotate(180deg);}
.hr-rows{display:none;}
.hr-module.open .hr-rows{display:block;}
.hr-row{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;padding:11px 22px;border-bottom:1px solid #24234a;background:#131028;text-decoration:none;cursor:default;-webkit-transition:background .12s;transition:background .12s;}
.hr-row:last-child{border-bottom:none;}
.hr-row:hover{background:#1b1740;}
.hr-row.bordro{background:#1c1608;cursor:pointer;}
.hr-row.bordro:hover{background:#241d0c;}
.hr-row.grup{background:#141c3a;cursor:pointer;}
.hr-row.grup:hover{background:#1a2550;}
.hr-row-logo{height:24px;width:44px;object-fit:contain;-ms-flex-negative:0;flex-shrink:0;border-radius:4px;background:#fff8ec;padding:2px 5px;margin-right:14px;}
.hr-row-icon{font-size:16px;width:30px;height:30px;border-radius:8px;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:center;justify-content:center;-ms-flex-negative:0;flex-shrink:0;background:#8b5cf62e;border:1px solid #8b5cf64d;margin-right:14px;}
.hr-row.bordro .hr-row-icon{background:#f59e0b2e;border:1px solid #f59e0b4d;}
.hr-tag{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;padding:3px 9px;border-radius:5px;-ms-flex-negative:0;flex-shrink:0;color:#c4b5fd;border:1px solid #8b5cf655;background:#8b5cf61a;margin-right:14px;}
.hr-row.bordro .hr-tag{color:#fcd34d;border:1px solid #f59e0b55;background:#f59e0b1a;}
.hr-row.grup .hr-tag{color:#93c5fd;border:1px solid #3b82f655;background:#3b82f61a;}
.hr-row-text{-ms-flex:1;flex:1;min-width:0;}
.hr-row-title{display:block;font-size:13.5px;font-weight:800;color:#f8fafc;}
.hr-row-file{display:block;font-size:11px;color:#a7b4d4;font-weight:600;margin-top:2px;}
.hr-row-actions{display:-ms-flexbox;display:flex;-ms-flex-negative:0;flex-shrink:0;margin-left:14px;}
.hr-mini-btn{display:-ms-inline-flexbox;display:inline-flex;-ms-flex-align:center;align-items:center;padding:6px 14px;border:1px solid #8b5cf655;border-radius:7px;background:#8b5cf61f;color:#f5f3ff;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer;white-space:nowrap;margin-left:8px;}
.hr-mini-btn:first-child{margin-left:0;}
.hr-mini-btn:hover{background:#8b5cf63a;}
.hr-mini-btn.alt{border:1px solid #fbbf2466;background:#fbbf241f;color:#fde68a;}
.hr-mini-btn.alt:hover{background:#fbbf243a;}
.hr-arrow{font-size:17px;color:#c4b5fd;font-weight:800;-ms-flex-negative:0;flex-shrink:0;margin-left:14px;}
.hr-row.bordro .hr-arrow{color:#fcd34d;}
.hr-row.grup .hr-arrow{color:#93c5fd;}

.section{margin-bottom:32px;}
.sec-header{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:11px;margin-bottom:15px;padding-bottom:11px;border-bottom:2px solid #232d4d;}
.sec-dot{width:13px;height:13px;border-radius:50%;-ms-flex-negative:0;flex-shrink:0;box-shadow:0 0 9px 1px currentColor;}
.sec-title{font-size:16px;font-weight:800;color:#f8fafc;text-transform:uppercase;letter-spacing:.7px;}
.sec-count{font-size:12.5px;color:#94a1c4;margin-left:auto;font-weight:700;}
.sec-toggle{cursor:pointer;color:#a7b4d4;font-size:13px;margin-left:10px;-webkit-user-select:none;-ms-user-select:none;user-select:none;text-decoration:none;font-weight:700;}
.sec-toggle:hover{color:#ffffff;}

.card-grid{display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;margin:-4px;}
.link-card{display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:9px;padding:9px 11px;background:#151c34;border:1px solid #2a3660;border-left-width:3px;border-left-style:solid;border-radius:8px;color:#e2e8f0;cursor:pointer;margin:4px;width:calc(20% - 8px);-ms-flex:0 0 calc(20% - 8px);flex:0 0 calc(20% - 8px);text-decoration:none;-webkit-transition:background .12s,-webkit-transform .12s;transition:background .12s,transform .12s;}
.link-card:hover{background:#1d2a4d;-webkit-transform:translateY(-1px);transform:translateY(-1px);}
.link-card.hidden{display:none;}
.card-icon{font-size:16px;-ms-flex-negative:0;flex-shrink:0;width:30px;height:30px;border-radius:8px;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-ms-flex-pack:center;justify-content:center;}
.card-title{font-size:12px;font-weight:700;line-height:1.3;color:#f8fafc;}
.card-file{font-size:10px;color:#93a3c4;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px;font-weight:600;}
.link-card:hover .card-file{color:#93c5fd;}

.link-card.featured{background:linear-gradient(135deg,#1c2b52,#161c34);border:1.5px solid #3b82f6;box-shadow:0 0 0 1px #3b82f640,0 4px 16px rgba(59,130,246,.35);}
.link-card.featured:hover{box-shadow:0 0 0 1px #3b82f666,0 6px 22px rgba(59,130,246,.5);}
.link-card.featured .card-icon{background:#3b82f64d;box-shadow:0 0 10px rgba(59,130,246,.5);}
.featured-badge{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:5px;font-size:8.5px;font-weight:800;letter-spacing:.4px;color:#0a0e1a;background:#60a5fa;vertical-align:1px;}
.co-tag{display:inline-block;margin-right:6px;padding:1px 6px;border-radius:5px;font-size:9px;font-weight:800;letter-spacing:.3px;color:#0a0e1a;background:#93c5fd;vertical-align:1px;}

.s1 .link-card{border-left-color:#3b82f6;} .s1 .sec-dot{background:#3b82f6;color:#3b82f6;} .s1 .card-icon{background:#3b82f633;} .s1 .sec-title{color:#93c5fd;}
.s2 .link-card{border-left-color:#8b5cf6;} .s2 .sec-dot{background:#8b5cf6;color:#8b5cf6;} .s2 .card-icon{background:#8b5cf633;} .s2 .sec-title{color:#c4b5fd;}
.s3 .link-card{border-left-color:#10b981;} .s3 .sec-dot{background:#10b981;color:#10b981;} .s3 .card-icon{background:#10b98133;} .s3 .sec-title{color:#6ee7b7;}
.s4 .link-card{border-left-color:#f59e0b;} .s4 .sec-dot{background:#f59e0b;color:#f59e0b;} .s4 .card-icon{background:#f59e0b33;} .s4 .sec-title{color:#fcd34d;}
.s5 .link-card{border-left-color:#ec4899;} .s5 .sec-dot{background:#ec4899;color:#ec4899;} .s5 .card-icon{background:#ec489933;} .s5 .sec-title{color:#f9a8d4;}
.s6 .link-card{border-left-color:#06b6d4;} .s6 .sec-dot{background:#06b6d4;color:#06b6d4;} .s6 .card-icon{background:#06b6d433;} .s6 .sec-title{color:#67e8f9;}
.s7 .link-card{border-left-color:#ef4444;} .s7 .sec-dot{background:#ef4444;color:#ef4444;} .s7 .card-icon{background:#ef444433;} .s7 .sec-title{color:#fca5a5;}
.s8 .link-card{border-left-color:#84cc16;} .s8 .sec-dot{background:#84cc16;color:#84cc16;} .s8 .card-icon{background:#84cc1633;} .s8 .sec-title{color:#bef264;}
.s9 .link-card{border-left-color:#64748b;} .s9 .sec-dot{background:#64748b;color:#64748b;} .s9 .card-icon{background:#64748b33;} .s9 .sec-title{color:#cbd5e1;}
.s9.section-muted{opacity:.5;-webkit-transition:opacity .15s;transition:opacity .15s;}
.s9.section-muted:hover{opacity:1;}
.s9.section-muted .sec-title{font-size:13px;font-weight:700;}
.s9.section-muted .sec-dot{width:9px;height:9px;box-shadow:none;}
.s9.section-muted .link-card{padding:6px 9px;border-left-width:2px;}
.s9.section-muted .card-icon{font-size:13px;width:24px;height:24px;}
.s9.section-muted .card-title{font-size:11px;font-weight:600;}
.s10 .link-card{border-left-color:#14b8a6;} .s10 .sec-dot{background:#14b8a6;color:#14b8a6;} .s10 .card-icon{background:#14b8a633;} .s10 .sec-title{color:#5eead4;}

@media(max-width:1750px){.link-card{width:calc(25% - 8px);-ms-flex:0 0 calc(25% - 8px);flex:0 0 calc(25% - 8px);}}
@media(max-width:1400px){.link-card{width:calc(33.333% - 8px);-ms-flex:0 0 calc(33.333% - 8px);flex:0 0 calc(33.333% - 8px);}.kpi{width:calc(33.333% - 12px);-ms-flex:0 0 calc(33.333% - 12px);flex:0 0 calc(33.333% - 12px);}}
@media(max-width:1000px){.link-card{width:calc(50% - 8px);-ms-flex:0 0 calc(50% - 8px);flex:0 0 calc(50% - 8px);}}
@media(max-width:820px){.link-card{width:calc(100% - 8px);-ms-flex:0 0 calc(100% - 8px);flex:0 0 calc(100% - 8px);}.kpi{width:calc(50% - 12px);-ms-flex:0 0 calc(50% - 12px);flex:0 0 calc(50% - 12px);}}

.footer{text-align:center;color:#6b7aa3;font-size:12px;padding:24px;border-top:1px solid #202a48;margin-top:16px;font-weight:600;}
</style>
</head>
<body>

<div class="fixed-top" id="fixedTop">
<div class="header">
  <div class="header-left">
    <div class="logo"><img src="CLAUDE\sc_grup_logo.png" alt="Logo"></div>
    <div>
      <div class="h-title"><span class="h-t1">CLAUDE</span><span class="h-t2">&mdash;</span><span class="h-t3">Panosu</span></div>
    </div>
  </div>
  <div class="info-chips">
