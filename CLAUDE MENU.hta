// CLAUDE\ dışındaki (Desktop kökündeki diğer) klasörlerdeki uygulamaları başlatmak için.
function getDesktopDir() {
    var base = getBaseDir(); // ...Desktop\CLAUDE\
    return base.substring(0, base.length - 'CLAUDE\\'.length);
}

function openDesktopApp(relPath) {
    try {
        var sh = new ActiveXObject('WScript.Shell');
        var fullPath = getDesktopDir() + relPath;
        sh.Run('"' + fullPath + '"', 1, false);
    } catch(e) {
        alert('Uygulama başlatılamadı.\n\nDosya: ' + relPath + '\n\nHata: ' + e.message);
    }
}

// ─── Arama fonksiyonu ─────────────────────────────────────────────────────────
function doSearch() {
    var q = document.getElementById('searchInput').value.toLowerCase();
    var cards = document.getElementsByClassName('link-card');
    var vis = 0;
    for (var i = 0; i < cards.length; i++) {
        var show = !q || cards[i].innerHTML.toLowerCase().indexOf(q) >= 0;
        cards[i].className = show
            ? cards[i].className.replace(' hidden','')
            : (cards[i].className.indexOf('hidden') < 0 ? cards[i].className + ' hidden' : cards[i].className);
        if (show) vis++;
    }
    var rc = document.getElementById('resultCount');
    if (q) {
        rc.innerHTML = vis + ' dosya bulundu';
        rc.style.color = vis > 0 ? '#60a5fa' : '#fc8181';
    } else {
        rc.innerHTML = '';
    }
}

// ─── İK Modülü combo box aç/kapat ─────────────────────────────────────────────
function toggleHrModule() {
    var mod = document.getElementById('hrModule');
    if (!mod) return;
    var isOpen = (' ' + mod.className + ' ').indexOf(' open ') >= 0;
    mod.className = isOpen ? mod.className.replace(' open', '') : mod.className + ' open';
    fitHeader();
}

// ─── Bölüm daralt/genişlet ────────────────────────────────────────────────────
function toggleSec(id) {
    var sec = document.getElementById(id);
    if (!sec) return;
    var bodies = sec.getElementsByClassName('sec-body');
    var toggle = sec.getElementsByClassName('sec-toggle')[0];
    if (!bodies.length) return;
    var isHidden = bodies[0].style.display === 'none';
    bodies[0].style.display = isHidden ? '' : 'none';
    if (toggle) toggle.innerHTML = isHidden ? '[daralt]' : '[genişlet]';
}

</script>
</body>
</html>
